# Copiá este archivo como .env y completá los valores a mano.
# .env está en .gitignore: nunca se sube al repo.

# API de Anthropic para el análisis con LLM (Hito 8). Sin key, la app funciona
# igual pero sin la parte del LLM.
ANTHROPIC_API_KEY=

# Opcional. Si está vacía, las noticias salen de los RSS de CoinDesk y
# Cointelegraph.
CRYPTOPANIC_API_KEY=

# Fase 1: NO se usan API keys de exchanges. La app no puede operar.
