# Secretos: las API keys las escribe el usuario a mano en .env
.env
.env.*
!.env.example

# Datos locales (base SQLite, modelos HMM, lock, informes)
data/*
!data/.gitkeep
# Bases SQLite, archivo LOCKED e informes de incidentes en cualquier carpeta
# (por ejemplo, una --db de prueba en backend/ o en la raíz): son datos
# personales y nunca se suben.
*.db
*.db-journal
*.db-wal
*.db-shm
LOCKED
incidents/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Node
node_modules/
frontend/dist/
*.tsbuildinfo

# Sistema / editores
.DS_Store
.idea/
.vscode/
*.log
